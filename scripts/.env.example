# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ALLOWED_USERS=your_telegram_user_id_here

# Inbox directory (relative to project root by default)
INBOX_DIR=

# Anthropic API key (for Claude-based pipeline processing)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub repo for Quartz deployment
GITHUB_REPO={{SITE_NAME}}/your-repo-name

# Bot display name (used in help text)
BOT_NAME={{BOT_NAME}}

# Claude CLI path (used by inbox_watcher.py to trigger pipeline)
CLAUDE_CLI_PATH=claude